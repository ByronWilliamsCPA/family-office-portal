    "allow": [
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pre-commit:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(basedpyright:*)",
      "Bash(tailwindcss:*)",
      "Bash(detect-secrets:*)",
