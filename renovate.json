{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Do not auto-update requires-python; version range is managed manually via the CI matrix strategy",
      "matchManagers": ["pep621"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": [
        "uv"
      ],
      "matchDepTypes": [
        "dev"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Track org workflow floating v1 tag for SHA pin updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackagePatterns": [
        "ByronWilliamsCPA/.github",
        "williaby/.github"
      ],
      "versioning": "semver",
      "followTag": "v1"
    }
  ],
  "lockFileMaintenance": {
    "commitMessageAction": "refresh",
    "commitMessageTopic": "Python dependency lock file"
  },
  "prConcurrentLimit": 5,
  "schedule": [
    "before 6am on Monday"
  ]
}
