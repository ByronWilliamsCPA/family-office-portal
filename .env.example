# Environment variables for the family office portal.
#
# Copy this file to .env and fill it in. Every setting the application reads
# is listed here by name, and tests/unit/test_env_example.py fails when this
# file and the code disagree.
#
# How to read this file:
#   - A line such as NAME=value is active as shipped.
#   - A line such as "# NAME=" is documented but switched off. Remove the
#     leading "# " to use it.
#   - Every secret (names ending in _KEY or _SECRET) is deliberately left
#     empty. Supply each one from the deployment's secret store; never commit a
#     real value to this file or to the repository.
#   - Optional features are off as shipped: copying this file enables no
#     backend connection, no chat and no document search.
#   - Write values without quotes, so Docker and the shell read them the same.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Required, no default. Filesystem path of the SQLite cache database. The
# application exits at startup when this is empty.
SQLITE_PATH=

# Optional, default UTC. IANA time zone name (for example America/Chicago) used
# for the "last updated" labels shown to people using the portal.
DISPLAY_TIMEZONE=UTC

# Optional, default true. Set to false to start without the background refresh
# jobs, for example when working on templates with no backends available.
SCHEDULER_ENABLED=true

# Optional, default 10. Seconds to wait for one call to a backend service.
BACKEND_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Sign-in (Authentik forward auth)
# ---------------------------------------------------------------------------

# Required, no default. SECRET. The Authentik provider's client secret, used to
# verify the signed identity token on every request. It must be at least 32
# characters with no leading or trailing whitespace. Supply it from the
# deployment's secret store.
AUTHENTIK_JWT_SECRET=

# Required, no default. The exact issuer URL expected in the identity token.
AUTHENTIK_ISSUER=

# Required, no default. The audience expected in the identity token (the
# provider's client ID).
AUTHENTIK_AUDIENCE=

# Optional, default fo-admin. Authentik group whose members get the Admin role.
# Must differ from FO_VIEWER_GROUP.
FO_ADMIN_GROUP=fo-admin

# Optional, default fo-viewer. Authentik group whose members get the Viewer
# role. Must differ from FO_ADMIN_GROUP.
FO_VIEWER_GROUP=fo-viewer

# ---------------------------------------------------------------------------
# Backend services (all optional; each is a URL plus its API key)
# ---------------------------------------------------------------------------
# A backend whose URL is unset is treated as not connected: its refresh jobs
# skip and its pages say so. When a URL is set, its API key is required and
# the application refuses to start without it. Set both of a pair or neither.

# llc-manager base URL.
# BACKEND_LLC_MANAGER_URL=
# SECRET. llc-manager API key; required when BACKEND_LLC_MANAGER_URL is set.
# BACKEND_LLC_MANAGER_API_KEY=

# pp-security-master base URL.
# BACKEND_PP_SECURITY_URL=
# SECRET. pp-security-master API key; required when BACKEND_PP_SECURITY_URL is
# set.
# BACKEND_PP_SECURITY_API_KEY=

# xero-crypto base URL.
# BACKEND_XERO_CRYPTO_URL=
# SECRET. xero-crypto API key; required when BACKEND_XERO_CRYPTO_URL is set.
# BACKEND_XERO_CRYPTO_API_KEY=

# data-ingestor base URL. No part of the portal calls it yet.
# BACKEND_DATA_INGESTOR_URL=
# SECRET. data-ingestor API key; required when BACKEND_DATA_INGESTOR_URL is
# set.
# BACKEND_DATA_INGESTOR_API_KEY=

# ---------------------------------------------------------------------------
# Balance intake (optional)
# ---------------------------------------------------------------------------

# Optional, no default. SECRET. Shared key a collector sends to
# POST /api/v1/balances. When unset, that endpoint answers 404. When set it
# must be at least 32 printable ASCII characters and must differ from
# AUTHENTIK_JWT_SECRET.
# BALANCE_INTAKE_API_KEY=

# ---------------------------------------------------------------------------
# Chat (optional; off while LLM_BASE_URL is unset)
# ---------------------------------------------------------------------------

# Base URL of an OpenAI-compatible chat service, without a trailing /v1 (the
# portal adds /v1/chat/completions itself).
# LLM_BASE_URL=

# SECRET. Bearer key for the chat service; required when LLM_BASE_URL is set.
# LLM_API_KEY=

# Optional. Model name sent with each chat request.
# LLM_MODEL=

# Optional, default 30. Most seconds one model call may take; a number above
# zero.
# LLM_TIMEOUT_SECONDS=30

# Optional. Path of the chat instructions file. Chat is off while this is
# unset.
# CHAT_INSTRUCTIONS_PATH=

# Optional, default admin. Who can see chat: admin, all or none.
# CHAT_ENABLED_FOR=admin

# Optional, default 6. Most questions one person may ask in any 60 seconds.
# A whole number above zero. One question at a time per person is always
# enforced.
# CHAT_RATE_LIMIT_PER_MINUTE=6

# Optional, default 60. Most questions one person may ask in any hour. A
# whole number above zero.
# CHAT_RATE_LIMIT_PER_HOUR=60

# ---------------------------------------------------------------------------
# Document search (optional; each part is off while its URL or path is unset)
# ---------------------------------------------------------------------------

# Base URL of an OpenAI-compatible embeddings service, without a trailing /v1
# (the portal adds /v1/embeddings itself).
# EMBED_BASE_URL=

# SECRET. Bearer key for the embeddings service; required when EMBED_BASE_URL
# is set.
# EMBED_API_KEY=

# Embedding model name; required when EMBED_BASE_URL is set. The model must
# return vectors of exactly 1024 dimensions.
# EMBEDDING_MODEL=

# Optional, default 60. Most seconds one embedding request may take; a number
# above zero.
# EMBED_TIMEOUT_SECONDS=60

# Qdrant base URL.
# QDRANT_URL=

# SECRET. Qdrant API key; required when QDRANT_URL is set.
# QDRANT_API_KEY=

# Directory of chunk-set files read by the indexer.
# CHUNKS_DIR=

# Path of the tax-law knowledge-base file read by the tax-law indexer.
# TAX_LAW_PATH=
