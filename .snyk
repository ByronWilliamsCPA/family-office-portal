# Snyk policy file
# Scopes Snyk Open Source scanning to project-owned code only.
# Excludes on-disk trees that are not project dependencies:
# virtual environments, worktree checkouts, build artifacts, and
# vendored JS bundled inside Python packages.
version: v1.25.0
exclude:
  global:
    - .venv/**
    - "**/.venv/**"
    - .worktrees/**
    - "**/.worktrees/**"
    - node_modules/**
    - "**/node_modules/**"
    - site/**
    - htmlcov/**
    - out/**
    - "**/site-packages/**"
    # static/ currently holds only a .gitkeep placeholder (Phase 0). Phase 1
    # vendors pre-built, third-party JS assets (htmx, Chart.js) here per
    # CLAUDE.md's static/ layout notes; this exclusion assumes those future
    # assets are not project dependencies. #ASSUME static/ will hold only
    # vendored third-party bundles. #VERIFY when static/ gains real files:
    # confirm each is vendored third-party code, not first-party JS, before
    # leaving this exclusion in place, since it would otherwise hide
    # first-party code from scanning.
    - static/**
