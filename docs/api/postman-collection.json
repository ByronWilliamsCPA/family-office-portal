{
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.variables.get('baseUrl')) { pm.variables.set('baseUrl', 'http://localhost:8000'); }"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "info": {
    "_postman_id": "family-office-portal-collection",
    "description": "Private read-only family estate portal aggregating entity, document, finance, and portfolio data from internal backend services behind a SQLite read-through cache. Runs behind Authentik forward auth. Page routes return server-rendered HTML; admin and health routes return JSON. See docs/planning/tech-spec.md for the full contract.",
    "name": "Family Office Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const authed = Boolean(pm.variables.get('authentikJwt'));",
                  "pm.test('status is in the expected range', function () {",
                  "    const expected = authed ? [200] : [403];",
                  "    pm.expect(expected).to.include(pm.response.code);",
                  "});",
                  "if (authed) {",
                  "    pm.test('response body is valid JSON', function () {",
                  "        pm.response.to.have.jsonBody();",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Per-service refresh log",
          "request": {
            "description": "Return the latest success and failure per backend service.\n\nAuthentication: Admin only (ADR-005). Services that have never run are\nomitted.\n\nReturns:\n    RefreshStatusResponse: One entry per service that has run.",
            "header": [
              {
                "key": "X-authentik-jwt",
                "type": "text",
                "value": "{{authentikJwt}}"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "refresh-status"
              ],
              "raw": "{{baseUrl}}/admin/refresh-status"
            }
          },
          "response": []
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const authed = Boolean(pm.variables.get('authentikJwt'));",
                  "pm.test('status is in the expected range', function () {",
                  "    const expected = authed ? [202, 422] : [403];",
                  "    pm.expect(expected).to.include(pm.response.code);",
                  "});",
                  "if (authed) {",
                  "    pm.test('response body is valid JSON', function () {",
                  "        pm.response.to.have.jsonBody();",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Trigger a manual refresh",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"force\": true\n}"
            },
            "description": "Run the named refresh job after the response is sent.\n\nAuthentication: Admin only (ADR-005).\n\nArgs:\n    service (Literal[\"entities\", \"holdings\", \"positions\", \"documents\"]):\n        Dataset to refresh.\n    body (RefreshTriggerRequest): Trigger options. Refreshes always run\n        now; ``force`` is echoed for compatibility.\n    background (BackgroundTasks): FastAPI background task queue.\n\nReturns:\n    RefreshTriggerResponse: Confirmation that the job was queued.",
            "header": [
              {
                "key": "X-authentik-jwt",
                "type": "text",
                "value": "{{authentikJwt}}"
              },
              {
                "key": "Content-Type",
                "type": "text",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "refresh",
                ":service"
              ],
              "raw": "{{baseUrl}}/admin/refresh/:service",
              "variable": [
                {
                  "key": "service",
                  "value": "example"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "name": "admin"
    },
