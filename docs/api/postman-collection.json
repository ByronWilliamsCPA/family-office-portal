          "name": "Download a document",
          "request": {
            "description": "Download a document.\n\nThe file proxy to llc-manager lands with MVP task C5; until then a known\ndocument returns 503.\n\nArgs:\n    request (Request): Current request.\n    document_id (str): Document identifier.\n\nRaises:\n    HTTPException: 404 when unknown or not visible, 503 until C5.",
            "header": [
              {
                "key": "X-authentik-jwt",
                "type": "text",
                "value": "{{authentikJwt}}"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                ":document_id",
                "download"
              ],
              "raw": "{{baseUrl}}/documents/:document_id/download",
              "variable": [
                {
                  "key": "document_id",
                  "value": "example"
                }
              ]
            }
          },
          "response": []
