{
  "components": {
    "schemas": {
      "BalanceReceipt": {
        "additionalProperties": false,
        "description": "Response for an accepted delivery.",
        "properties": {
          "accepted": {
            "description": "Number of rows stored.",
            "examples": [
              3
            ],
            "title": "Accepted",
            "type": "integer"
          },
          "providers": {
            "description": "Providers whose rows were replaced.",
            "examples": [
              [
                "pp",
                "xero"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "providers"
        ],
        "title": "BalanceReceipt",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness probe payload returned by ``GET /health``.",
        "properties": {
          "service": {
            "description": "Service name reported by the running process.",
            "examples": [
              "family-office-portal"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "Service status indicator.",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RefreshLogEntry": {
        "description": "One row of the refresh history for a backend service.",
        "properties": {
          "is_stale": {
            "description": "True when the cached dataset has exceeded its staleness window.",
            "examples": [
              false
            ],
            "title": "Is Stale",
            "type": "boolean"
          },
          "last_error_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 8601 timestamp of the most recent failed refresh, if any.",
            "examples": [
              "2026-05-15T22:14:01Z"
            ],
            "title": "Last Error At"
          },
          "last_error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Truncated error message from the most recent failure.",
            "examples": [
              "upstream returned HTTP 500"
            ],
            "title": "Last Error Message"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 8601 timestamp of the most recent successful refresh.",
            "examples": [
              "2026-05-16T03:00:00Z"
            ],
            "title": "Last Success At"
          },
          "service": {
            "description": "Backend service identifier.",
            "examples": [
              "llc-manager"
            ],
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "is_stale"
        ],
        "title": "RefreshLogEntry",
        "type": "object"
      },
      "RefreshStatusResponse": {
        "description": "Response payload for ``GET /admin/refresh-status``.",
        "properties": {
          "entries": {
            "description": "One entry per backend service tracked by the scheduler.",
            "items": {
              "$ref": "#/components/schemas/RefreshLogEntry"
            },
            "title": "Entries",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "RefreshStatusResponse",
        "type": "object"
      },
      "RefreshTriggerRequest": {
        "description": "Request body for ``POST /admin/refresh/{service}``.",
        "properties": {
          "force": {
            "default": false,
            "description": "When true, bypass the staleness check and refresh immediately even if cached data is fresh.",
            "examples": [
              true
            ],
            "title": "Force",
            "type": "boolean"
          }
        },
        "title": "RefreshTriggerRequest",
        "type": "object"
      },
      "RefreshTriggerResponse": {
        "description": "Response payload for ``POST /admin/refresh/{service}``.",
        "properties": {
          "forced": {
            "description": "True when the staleness check was bypassed.",
            "examples": [
              false
            ],
            "title": "Forced",
            "type": "boolean"
          },
          "scheduled": {
            "description": "True when the refresh job was enqueued.",
            "examples": [
              true
            ],
            "title": "Scheduled",
            "type": "boolean"
          },
          "service": {
            "description": "Backend service whose refresh job was scheduled.",
            "examples": [
              "llc-manager"
            ],
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "scheduled",
          "forced"
        ],
        "title": "RefreshTriggerResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Byron Williams"
    },
    "description": "Private read-only family estate portal aggregating entity, document, finance, and portfolio data from internal backend services behind a SQLite read-through cache. Runs behind Authentik forward auth. Page routes return server-rendered HTML; admin and health routes return JSON. See docs/planning/tech-spec.md for the full contract.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Family Office Portal",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Render the landing dashboard: totals, upcoming dates, recent documents.\n\nAuthentication: Viewer or Admin (ADR-005).\n\nArgs:\n    request (Request): Current request.\n\nReturns:\n    Response: Rendered dashboard page.",
        "operationId": "home__get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Home dashboard",
        "tags": [
          "home"
        ]
      }
    },
    "/admin/refresh-status": {
      "get": {
        "description": "Return the latest success and failure per backend service.\n\nAuthentication: Admin only (ADR-005). Services that have never run are\nomitted.\n\nReturns:\n    RefreshStatusResponse: One entry per service that has run.",
        "operationId": "refresh_status_admin_refresh_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Per-service refresh log",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/refresh/{service}": {
      "post": {
        "description": "Run the named refresh job after the response is sent.\n\nAuthentication: Admin only (ADR-005).\n\nArgs:\n    service (Literal[\"entities\", \"holdings\", \"positions\", \"documents\"]):\n        Dataset to refresh.\n    body (RefreshTriggerRequest): Trigger options. Refreshes always run\n        now; ``force`` is echoed for compatibility.\n    background (BackgroundTasks): FastAPI background task queue.\n\nReturns:\n    RefreshTriggerResponse: Confirmation that the job was queued.",
        "operationId": "trigger_refresh_admin_refresh__service__post",
        "parameters": [
          {
            "in": "path",
            "name": "service",
            "required": true,
            "schema": {
              "enum": [
                "entities",
                "holdings",
                "positions",
                "documents"
              ],
              "title": "Service",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTriggerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTriggerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation error"
          }
        },
        "summary": "Trigger a manual refresh",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/balances": {
      "post": {
        "description": "Replace stored balances with the rows in one delivery.\n\nAuthentication: a shared key in ``X-API-Key``, not a sign-in identity. A\nvalid sign-in does not authorise this route. When no key is configured the\nroute answers 404 and never accepts a request.\n\nRows replace the stored rows of each provider (the account id prefix) that\nappears in the delivery; a provider with no rows keeps its last values.\nEverything is stored in one transaction, then today's daily snapshot is\nwritten in the same transaction.\n\n#CRITICAL: security: the key is checked before the body is read or parsed.\n#VERIFY: tests/unit/test_balance_intake.py sends a missing or wrong key\nwith a body over ``MAX_BODY_BYTES`` (declared and streamed) and expects\n401, not 413, and checks the key is compared with ``hmac.compare_digest``.\n\nArgs:\n    request (Request): Current request; the body is read here so the key is\n        checked first.\n\nReturns:\n    Response: 200 with a receipt, or a JSON error (401, 404, 413, 422,\n    503) with a ``detail`` string and no submitted values.",
        "operationId": "receive_balances_api_v1_balances_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "A full delivery of balance rows: ``{\"items\": [...], \"total\": n}``.",
                "examples": [
                  {
                    "items": [
                      {
                        "account_id": "pp:example-brokerage",
                        "account_name": "Example Brokerage",
                        "as_of": "2026-09-26",
                        "category": "Cash",
                        "currency": "USD",
                        "entity_id": "11111111-2222-4333-8444-555555555555",
                        "source": "broker_report",
                        "value": "1234.56"
                      }
                    ],
                    "total": 1
                  }
                ],
                "properties": {
                  "items": {
                    "description": "Every balance row in this delivery.",
                    "items": {
                      "additionalProperties": false,
                      "description": "One account balance in a delivery.\n\nValidation is strict: ``value`` must be a JSON string (a number is\nrejected), and no field is coerced from another type. Error messages never\ncontain the submitted value.",
                      "properties": {
                        "account_id": {
                          "description": "Stable account id prefixed with its provider (pp:, xero:, crypto:). Never a full account number.",
                          "examples": [
                            "pp:example-brokerage"
                          ],
                          "pattern": "^(pp|xero|crypto):[A-Za-z0-9._:-]{1,100}$",
                          "title": "Account Id",
                          "type": "string"
                        },
                        "account_name": {
                          "description": "Plain-English account name shown to people.",
                          "examples": [
                            "Example Brokerage"
                          ],
                          "maxLength": 200,
                          "minLength": 1,
                          "title": "Account Name",
                          "type": "string"
                        },
                        "as_of": {
                          "description": "Date the value is true for, YYYY-MM-DD.",
                          "examples": [
                            "2026-09-26"
                          ],
                          "format": "date",
                          "title": "As Of",
                          "type": "string"
                        },
                        "category": {
                          "description": "Account category.",
                          "enum": [
                            "Investments",
                            "Retirement",
                            "Cash",
                            "Digital currency",
                            "Alternatives"
                          ],
                          "title": "Category",
                          "type": "string"
                        },
                        "currency": {
                          "description": "Three-letter currency code.",
                          "examples": [
                            "USD"
                          ],
                          "pattern": "^[A-Z]{3}$",
                          "title": "Currency",
                          "type": "string"
                        },
                        "entity_id": {
                          "description": "Entity UUID that owns the account. Never null.",
                          "examples": [
                            "11111111-2222-4333-8444-555555555555"
                          ],
                          "format": "uuid",
                          "title": "Entity Id",
                          "type": "string"
                        },
                        "reconciled_through": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Bank rows only: latest date with no unreconciled statement lines.",
                          "format": "date",
                          "title": "Reconciled Through"
                        },
                        "source": {
                          "description": "Feed name, for example broker_report or manual_mark.",
                          "examples": [
                            "broker_report"
                          ],
                          "pattern": "^[a-z][a-z0-9_]{0,39}$",
                          "title": "Source",
                          "type": "string"
                        },
                        "value": {
                          "description": "Decimal amount as a JSON string, never a number: an optional minus sign, at most 12 digits before the point and at most 4 after it (rounded half to even to whole cents when stored).",
                          "examples": [
                            "1234.56"
                          ],
                          "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,4})?$",
                          "title": "Value",
                          "type": "string"
                        }
                      },
                      "required": [
                        "account_id",
                        "account_name",
                        "entity_id",
                        "category",
                        "source",
                        "value",
                        "currency",
                        "as_of"
                      ],
                      "title": "BalanceRow",
                      "type": "object"
                    },
                    "maxItems": 2000,
                    "title": "Items",
                    "type": "array"
                  },
                  "total": {
                    "description": "Number of rows; must equal the length of items.",
                    "minimum": 0.0,
                    "title": "Total",
                    "type": "integer"
                  }
                },
                "required": [
                  "items",
                  "total"
                ],
                "title": "BalanceDelivery",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or wrong X-API-Key."
          },
          "404": {
            "description": "The intake is disabled (no key configured)."
          },
          "413": {
            "description": "Body too large."
          },
          "422": {
            "description": "Body failed validation; nothing was stored."
          },
          "503": {
            "description": "The database write failed; nothing was changed."
          }
        },
        "summary": "Deliver account balances",
        "tags": [
          "balances"
        ]
      }
    },
    "/documents": {
      "get": {
        "description": "Render documents grouped by category, with optional name search.\n\nWorks without JavaScript: the search form submits here with ``q``.\nAuthentication: Viewer or Admin (ADR-005). Viewers never see\nconfidential documents.\n\nArgs:\n    request (Request): Current request.\n    q (OptionalSearch): Optional name search text.\n\nReturns:\n    Response: Rendered documents page.",
        "operationId": "documents_index_documents_get",
        "parameters": [
          {
            "description": "Optional name search.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional name search.",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Document folders",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/search": {
      "get": {
        "description": "Return the search results fragment used by the Documents page.\n\nWhen the document service is not connected the fragment says so, as the\nfull page does, instead of listing links that could only answer 503.\n\nArgs:\n    request (Request): Current request.\n    q (RequiredSearch): Text to find in document names.\n\nReturns:\n    Response: HTML fragment listing matching documents.",
        "operationId": "documents_search_documents_search_get",
        "parameters": [
          {
            "description": "Text to find in names.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Text to find in names.",
              "maxLength": 200,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search documents by name (HTMX partial)",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/download": {
      "get": {
        "description": "Download a document as a file.\n\nAuthentication: Viewer or Admin (ADR-005); Viewers get 404 for\nconfidential documents.\n\nArgs:\n    request (Request): Current request.\n    document_id (str): Document identifier.\n\nReturns:\n    StreamingResponse: The file as an attachment.",
        "operationId": "document_download_documents__document_id__download_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file, streamed from the document service"
          },
          "404": {
            "description": "Document not found, or not visible to this user"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "description": "The document service failed or refused the request"
          },
          "503": {
            "description": "The document service is not connected"
          },
          "504": {
            "description": "The document service did not answer in time"
          }
        },
        "summary": "Download a document",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/preview": {
      "get": {
        "description": "Show a document in the browser.\n\nPDFs and images open inline; any other type downloads instead. A link\nmay add ``#page=N`` to open a PDF at a page. Authentication: Viewer or\nAdmin (ADR-005); Viewers get 404 for confidential documents.\n\nArgs:\n    request (Request): Current request.\n    document_id (str): Document identifier.\n\nReturns:\n    StreamingResponse: The file, shown inline when its type allows.",
        "operationId": "document_preview_documents__document_id__preview_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file, streamed from the document service"
          },
          "404": {
            "description": "Document not found, or not visible to this user"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "description": "The document service failed or refused the request"
          },
          "503": {
            "description": "The document service is not connected"
          },
          "504": {
            "description": "The document service did not answer in time"
          }
        },
        "summary": "Inline document preview",
        "tags": [
          "documents"
        ]
      }
    },
    "/entities": {
      "get": {
        "description": "Render every cached LLC and trust.\n\nAuthentication: Viewer or Admin (ADR-005).\n\nArgs:\n    request (Request): Current request.\n\nReturns:\n    Response: Rendered entity list.",
        "operationId": "entities_index_entities_get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Entity list",
        "tags": [
          "entities"
        ]
      }
    },
    "/entities/{entity_id}": {
      "get": {
        "description": "Render one entity with its documents.\n\nAuthentication: Viewer or Admin (ADR-005).\n\nArgs:\n    request (Request): Current request.\n    entity_id (str): Entity identifier.\n\nReturns:\n    Response: Rendered entity page.\n\nRaises:\n    HTTPException: 404 when the entity is not cached.",
        "operationId": "entity_detail_entities__entity_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "entity_id",
            "required": true,
            "schema": {
              "title": "Entity Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Entity not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Entity detail",
        "tags": [
          "entities"
        ]
      }
    },
    "/finances": {
      "get": {
        "description": "Render account totals and crypto positions from the cache.\n\nAuthentication: Viewer or Admin (ADR-005).\n\nArgs:\n    request (Request): Current request.\n\nReturns:\n    Response: Rendered finances page.",
        "operationId": "finances_finances_get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Account totals and digital currency",
        "tags": [
          "finances"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Return a static liveness payload.\n\nUnauthenticated. Intended for orchestrator probes and the Newman CI\nworkflow so polling can begin before any backend services are reachable.\n\nReturns:\n    HealthResponse: Status indicator and service name.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/portfolio": {
