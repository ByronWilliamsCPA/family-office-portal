{
  "components": {
    "schemas": {
      "DocumentSearchHit": {
        "description": "Single search result returned by ``GET /documents/search``.",
        "properties": {
          "category": {
            "description": "Document category.",
            "examples": [
              "Taxes"
            ],
            "title": "Category",
            "type": "string"
          },
          "id": {
            "description": "Document identifier.",
            "examples": [
              "doc_4f10"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Display name of the document.",
            "examples": [
              "2025 K-1 Schedule"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category"
        ],
        "title": "DocumentSearchHit",
        "type": "object"
      },
      "DocumentSearchResponse": {
        "description": "Response payload for ``GET /documents/search``.",
        "properties": {
          "hits": {
            "description": "Matching documents in ranked order.",
            "items": {
              "$ref": "#/components/schemas/DocumentSearchHit"
            },
            "title": "Hits",
            "type": "array"
          }
        },
        "required": [
          "hits"
        ],
        "title": "DocumentSearchResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness probe payload returned by ``GET /health``.",
        "properties": {
          "service": {
            "description": "Service name reported by the running process.",
            "examples": [
              "family-office-portal"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "Service status indicator.",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RefreshLogEntry": {
        "description": "One row of the refresh history for a backend service.",
        "properties": {
          "is_stale": {
            "description": "True when the cached dataset has exceeded its staleness window.",
            "examples": [
              false
            ],
            "title": "Is Stale",
            "type": "boolean"
          },
          "last_error_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 8601 timestamp of the most recent failed refresh, if any.",
            "examples": [
              "2026-05-15T22:14:01Z"
            ],
            "title": "Last Error At"
          },
          "last_error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Truncated error message from the most recent failure.",
            "examples": [
              "upstream returned HTTP 500"
            ],
            "title": "Last Error Message"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 8601 timestamp of the most recent successful refresh.",
            "examples": [
              "2026-05-16T03:00:00Z"
            ],
            "title": "Last Success At"
          },
          "service": {
            "description": "Backend service identifier.",
            "examples": [
              "llc-manager"
            ],
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "is_stale"
        ],
        "title": "RefreshLogEntry",
        "type": "object"
      },
      "RefreshStatusResponse": {
        "description": "Response payload for ``GET /admin/refresh-status``.",
        "properties": {
          "entries": {
            "description": "One entry per backend service tracked by the scheduler.",
            "items": {
              "$ref": "#/components/schemas/RefreshLogEntry"
            },
            "title": "Entries",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "RefreshStatusResponse",
        "type": "object"
      },
      "RefreshTriggerRequest": {
        "description": "Request body for ``POST /admin/refresh/{service}``.",
        "properties": {
          "force": {
            "default": false,
            "description": "When true, bypass the staleness check and refresh immediately even if cached data is fresh.",
            "examples": [
              true
            ],
            "title": "Force",
            "type": "boolean"
          }
        },
        "title": "RefreshTriggerRequest",
        "type": "object"
      },
      "RefreshTriggerResponse": {
        "description": "Response payload for ``POST /admin/refresh/{service}``.",
        "properties": {
          "forced": {
            "description": "True when the staleness check was bypassed.",
            "examples": [
              false
            ],
            "title": "Forced",
            "type": "boolean"
          },
          "scheduled": {
            "description": "True when the refresh job was enqueued.",
            "examples": [
              true
            ],
            "title": "Scheduled",
            "type": "boolean"
          },
          "service": {
            "description": "Backend service whose refresh job was scheduled.",
            "examples": [
              "llc-manager"
            ],
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "scheduled",
          "forced"
        ],
        "title": "RefreshTriggerResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Byron Williams"
    },
    "description": "Private read-only family estate portal aggregating entity, document, finance, and portfolio data from four internal backend services behind a SQLite read-through cache. Runs behind Cloudflare Zero Trust. Page routes return server-rendered HTML; admin and health routes return JSON. See docs/planning/tech-spec.md for the full contract.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "Family Office Portal",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Render the landing dashboard.\n\nAuthentication: Viewer or Admin via Cloudflare Access (see ADR-002). Phase 0\nreturns a static HTML placeholder; Phase 1 will swap in a Jinja2 template\nthat aggregates the five sections.\n\nReturns:\n    HTMLResponse: Placeholder dashboard page.",
        "operationId": "home__get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Home dashboard",
        "tags": [
          "home"
        ]
      }
    },
    "/admin/refresh-status": {
      "get": {
        "description": "Return the most recent refresh outcome per backend service.\n\nAuthentication: Admin only via Cloudflare Access. Reads the ``refresh_log``\ntable populated by the APScheduler jobs.\n\nReturns:\n    RefreshStatusResponse: One entry per tracked backend.",
        "operationId": "refresh_status_admin_refresh_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Per-service refresh log",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/refresh/{service}": {
      "post": {
        "description": "Enqueue an out-of-band refresh for the named backend service.\n\nAuthentication: Admin only via Cloudflare Access. Phase 0 returns a stub\nresponse; Phase 1 will dispatch to the APScheduler job for the matching\nservice (``entities``, ``holdings``, ``positions``, ``documents``).\n\nArgs:\n    service: Backend service identifier to refresh.\n    body: Trigger options; set ``force`` to bypass the staleness check.\n\nReturns:\n    RefreshTriggerResponse: Confirmation of the scheduling decision.",
        "operationId": "trigger_refresh_admin_refresh__service__post",
        "parameters": [
          {
            "in": "path",
            "name": "service",
            "required": true,
            "schema": {
              "title": "Service",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTriggerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTriggerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation error"
          }
        },
        "summary": "Trigger a manual refresh",
        "tags": [
          "admin"
        ]
      }
    },
    "/documents": {
      "get": {
        "description": "Render the document folder view.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Data is read from\nthe SQLite cache populated by the ``refresh_documents`` job; the route\nnever calls the upstream ``family_office`` service directly (ADR-003).\n\nReturns:\n    HTMLResponse: Placeholder folder listing page.",
        "operationId": "documents_index_documents_get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List document folders",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/search": {
      "get": {
        "description": "Return documents whose name matches ``q``.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Designed as an HTMX\npartial in Phase 1; the JSON shape is returned at Phase 0 so the contract\nis OpenAPI-described from the start.\n\nArgs:\n    q: Free-text query string; must be at least one character.\n\nReturns:\n    DocumentSearchResponse: Matching documents in ranked order.",
        "operationId": "documents_search_documents_search_get",
        "parameters": [
          {
            "description": "Free-text search query.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Free-text search query.",
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search documents by name",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/download": {
      "get": {
        "description": "Stream the original document as a file download.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Phase 0 returns an\nempty placeholder; Phase 1 will stream upstream content with a\n``Content-Disposition: attachment`` header.\n\nArgs:\n    document_id: Opaque document identifier sourced from the cache.\n\nReturns:\n    Response: Placeholder binary response.",
        "operationId": "document_download_documents__document_id__download_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "Binary document download."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Download original document",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/preview": {
      "get": {
        "description": "Stream a PDF preview proxied from the ``family_office`` backend.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Phase 0 returns an\nempty placeholder; Phase 1 will stream upstream content.\n\nArgs:\n    document_id: Opaque document identifier sourced from the cache.\n\nReturns:\n    Response: Placeholder PDF response.",
        "operationId": "document_preview_documents__document_id__preview_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
            },
            "description": "PDF preview stream."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inline document preview",
        "tags": [
          "documents"
        ]
      }
    },
    "/entities": {
      "get": {
        "description": "Render the entity list with compliance status.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Reads the cached\n``entities`` dataset sourced from the ``llc-manager`` backend.\n\nReturns:\n    HTMLResponse: Placeholder entity list page.",
        "operationId": "entities_index_entities_get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List entities",
        "tags": [
          "entities"
        ]
      }
    },
    "/entities/{entity_id}": {
      "get": {
        "description": "Render a single entity detail view.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Raw identifiers\nare not surfaced to primary users (see CLAUDE.md frontend conventions);\nPhase 1 will render a plain-English summary backed by the cache.\n\nArgs:\n    entity_id: Opaque entity identifier sourced from the cache.\n\nReturns:\n    HTMLResponse: Placeholder entity detail page.",
        "operationId": "entity_detail_entities__entity_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "entity_id",
            "required": true,
            "schema": {
              "title": "Entity Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Entity detail",
        "tags": [
          "entities"
        ]
      }
    },
    "/finances": {
      "get": {
        "description": "Render the finances dashboard.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Aggregates the\n``holdings`` dataset (``pp-security-master``) with the ``positions``\ndataset (``xero_crypto``) from the SQLite cache.\n\nReturns:\n    HTMLResponse: Placeholder finances page.",
        "operationId": "finances_finances_get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Net worth and asset allocation",
        "tags": [
          "finances"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Return a static liveness payload.\n\nUnauthenticated. Intended for orchestrator probes and the Newman CI\nworkflow so polling can begin before any backend services are reachable.\n\nReturns:\n    HealthResponse: Status indicator and service name.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/portfolio": {
      "get": {
        "description": "Render the portfolio page.\n\nAuthentication: Viewer or Admin via Cloudflare Access. Reads the cached\n``holdings`` and ``performance`` datasets sourced from the\n``pp-security-master`` backend.\n\nReturns:\n    HTMLResponse: Placeholder portfolio page.",
        "operationId": "portfolio_portfolio_get",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Holdings and performance",
        "tags": [
          "portfolio"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness probes for orchestrators.",
      "name": "health"
    },
    {
      "description": "Landing dashboard.",
      "name": "home"
    },
    {
      "description": "Document folder views and proxied previews.",
      "name": "documents"
    },
    {
      "description": "Net worth and asset allocation aggregations.",
      "name": "finances"
    },
    {
      "description": "Holdings and performance from pp-security-master.",
      "name": "portfolio"
    },
    {
      "description": "LLC and trust list and detail views from llc-manager.",
      "name": "entities"
    },
    {
      "description": "Refresh status and manual refresh triggers (Admin role).",
      "name": "admin"
    }
  ]
}
